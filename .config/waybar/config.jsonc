{
	"spacing": 5,
	"layer": "top",
	"height": 50,
	"modules-left": [
		"custom/server",
		"cpu",
		"memory",
		"battery#power",
		"temperature",
		"network#stats",
	],
	"modules-center": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"network",
		"image",
		"pulseaudio",
		"clock"
	],
	"custom/server": {
		"interval": 3,
		"tooltip": false,
		"exec": "/home/marcman/.config/waybar/is_server_up.sh",
		"return-type": "json",
		"format": "Server: {text}"
	},
	"battery#power": {
	    "format": "{power:.1f}W",
	    "interval": 1,
	    "tooltip": false,
	},

	"battery": {
	    "states": {
		"good": 95,
		"warning": 30,
		"critical": 15
	    },

	    "format": "{capacity}%",
	    "format-full": "{capacity}%",
	    "format-charging": "{capacity}% ",
	    "format-plugged": "{capacity}%  ",
	    "format-alt": "{time}",
	    "interval": 30,
	},

	"memory": {
		"tooltip": false,
		"interval": 5,
		"format": "{used:.1f} GiB {icon}",
		"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
	},
	"temperature": {
		"tooltip": false
	},
	"cpu": {
		"tooltip": false,
		"interval": 1,
		"format": "{usage:2}% ",
	},
	"clock": {
		"format": "{:%d - %H:%M}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
	},
	"network": {
		"format-ethernet": "Leaked IP 😨 {ipaddr}/{cidr}",
		"tooltip": false,
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "Disconnected ⚠ ",
		"format-wifi": "Leaked IP 😨 {ipaddr}/{cidr}",
		"interval": 5
	},
	"network#stats": {
		"tooltip": false,
		"format-ethernet": "{bandwidthUpBytes}   {bandwidthDownBytes}  ",
		"format-wifi": "{signaldBm}dBm {bandwidthUpBytes}   {bandwidthDownBytes}  ",
		"interval": 1
	},
	"hyprland/workspaces": {
		"active-only": false,
		"all-outputs": true,
		"on-click": "activate",
		"on-scroll-up": "hyprctl dispatch workspace e+1",
		"on-scroll-down": "hyprctl dispatch workspace e-1",
		"show-special": false,
		"persistent-workspaces": {
			"*": 10
		},
		"format": "{icon}",
		"format-icons": {
			"active": "<span font='14'>󰮯 </span>",
			"empty": "<span font='9'> </span>",
			"default": "<span font='14'>󰊠 </span>"
		}
	},
	"pulseaudio": {
		"format": "{volume}% {icon} {format_source}",
		"format-bluetooth": "{volume}% {icon}󰂯 {format_source}",
		"format-bluetooth-muted": "{icon}󰂲 {format_source}",
		"format-muted": "  {format_source}",
		"format-source": "{volume}%  ",
		"format-source-muted": " ",
		"format-icons": {
			"headphone": " ",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				" ",
				" "
			]
		},
		"on-click": "pavucontrol"
	}
}
